@startuml
skinparam dpi 100
skinparam WrapWidth 200
autonumber "<b>[00]"

'title "FHIR-Directory, Sequenzdiagram SSP Authenticate mit Passwort"
actor o as "Org-Admin\noder LE"
participant cl as "KIM-Clientmodul"
participant ssp as "SelfService"
participant kimfd as "KIM Fachdienst"
participant ldap as "LDAP VZD"
participant fd as "FHIR-Directory"

note left of fd 
**KIM-Fachdaten**
LDAP-VZD: leer
FHIR-VZD: leer
end note

== Öffentlich sichtbare KIM-Adresse eintragen ==

o -> cl: KIM-Adresse einrichten\n(mail, kimVersion, noVzdMailEntry=false)
activate cl
cl -> kimfd: KIM-Adresse einrichten\n(mail, kimVersion, noVzdMailEntry=false)
activate kimfd
deactivate cl

kimfd -> ldap: KIM-Adresse einrichten\n(mail, kimVersion, noVzdMailEntry=false)
activate ldap
deactivate kimfd

ldap -> fd: Sync KIM-Adresse\n(mail, kimVersion)
activate fd
deactivate fd
deactivate ldap

note left of fd 
**KIM-Fachdaten**
LDAP-VZD:
<b>mail=oeffentliche-kim-adresse@test.kim.telematik
<b>komLeData=1.5,oeffentliche-kim-adresse@test.kim.telematik
<b>kimData=oeffentliche-kim-adresse@test.kim.telematik,1.5

FHIR-VZD:
<b>Endpoint.connectionType=kim
<b>Endpoint.connectionType.extension:kimVersion=1.5
<b>Endpoint.address=oeffentliche-kim-adresse@test.kim.telematik
end note

== KIM-Adresse für Fachverfahren eintragen - eingeschränkte Sichtbarkeit ==

o -> cl: KIM-Adresse einrichten\n(mail, kimVersion, noVzdMailEntry=true)
activate cl

cl -> kimfd: KIM-Adresse einrichten\n(mail, kimVersion, noVzdMailEntry=true)
activate kimfd
deactivate cl
kimfd -> ldap: KIM-Adresse einrichten\n(mail, kimVersion, noVzdMailEntry=true)
activate ldap
deactivate kimfd

ldap -> fd: Sync KIM-Adresse\n(mail, kimVersion)
activate fd
deactivate ldap
deactivate fd

note left of fd 
**KIM-Fachdaten**
LDAP-VZD:
mail=oeffentliche-kim-adresse@test.kim.telematik
komLeData=1.5,oeffentliche-kim-adresse@test.kim.telematik
kimData=oeffentliche-kim-adresse@test.kim.telematik,1.5

mail=
komLeData=
<b>kimData=fachverfahren1@test.kim.telematik,1.5

FHIR-VZD:
Endpoint.connectionType=kim
Endpoint.connectionType.extension:kimVersion=1.5
Endpoint.address=oeffentliche-kim-adresse@test.kim.telematik

<b>Endpoint.connectionType=kim
<b>Endpoint.connectionType.extension:kimVersion=1.5
<b>Endpoint.address=fachverfahren1@test.kim.telematik
end note

== appTag & Sichtbarkeit für KIM-Adresse eintragen ==

o -> ssp: appTag & Sichtbarkeit für KIM-Adresse eintragen
activate ssp
ssp -> fd: appTag & Sichtbarkeit für authentifizierten Nutzer eintragen
activate fd
deactivate ssp
deactivate fd

note left of fd 
**KIM-Fachdaten**
LDAP-VZD:
mail=oeffentliche-kim-adresse@test.kim.telematik
komLeData=1.5,oeffentliche-kim-adresse@test.kim.telematik
kimData=oeffentliche-kim-adresse@test.kim.telematik,1.5

mail=
komLeData=
kimData=fachverfahren1@test.kim.telematik,1.5

FHIR-VZD:
Endpoint.connectionType=kim
Endpoint.connectionType.extension:kimVersion=1.5
Endpoint.address=oeffentliche-kim-adresse@test.kim.telematik

Endpoint.connectionType=kim
Endpoint.connectionType.extension:kimVersion=1.5
<b>Endpoint.extension:endpointVisibility=Fachverfahren
<b>Endpoint.payloadType=eEB</b>
Endpoint.address=fachverfahren1@test.kim.telematik
end note
@enduml
